    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: TEST svg",
            "type": "debugpy",
            "request": "launch",
            "program": "svg_templates/svg_editor.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Main ui",
            "type": "debugpy",
            "request": "launch",
            "program": "main_ui.py",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
